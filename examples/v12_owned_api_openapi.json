{
  "openapi": "3.1.0",
  "info": {
    "title": "HunterQA Owned Training API",
    "version": "0.1",
    "description": "Offline-only synthetic contract; not a live application."
  },
  "servers": [
    {"url": "https://app.example.test"}
  ],
  "security": [{"BearerAuth": []}],
  "components": {
    "securitySchemes": {
      "BearerAuth": {"type": "http", "scheme": "bearer"}
    }
  },
  "paths": {
    "/v1/users/{userId}": {
      "get": {
        "tags": ["Accounts"],
        "parameters": [{"name": "userId", "in": "path", "required": true,
                        "schema": {"type": "string"}}],
        "responses": {"200": {"description": "Account data for an authorized test identity"}}
      },
      "patch": {
        "tags": ["Accounts"],
        "parameters": [{"name": "userId", "in": "path", "required": true,
                        "schema": {"type": "string"}}],
        "requestBody": {"content": {"application/json": {"schema": {"type": "object"}}}},
        "responses": {"200": {"description": "Updated test account"}}
      }
    },
    "/v1/public/contact": {
      "post": {
        "security": [],
        "responses": {"202": {"description": "Accepted"}}
      }
    },
    "/v1/admin/permissions": {
      "post": {
        "responses": {"204": {"description": "Completed"}}
      }
    }
  }
}
